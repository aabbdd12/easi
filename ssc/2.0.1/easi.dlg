PROGRAM ng_show
BEGIN
  if sel.cb_ng.iseq("0") {
    call script row1_hide
    call script row2_hide
    call script row3_hide
    call script row4_hide
    call script row5_hide
    call script row6_hide
    call script row7_hide
    call script row8_hide
    call script row9_hide
    call script row10_hide
  }
  if sel.cb_ng.iseq("1") {
    call script row1_show
    call script row2_hide
    call script row3_hide
    call script row4_hide
    call script row5_hide
    call script row6_hide
    call script row7_hide
    call script row8_hide
    call script row9_hide
    call script row10_hide
  }
  if sel.cb_ng.iseq("2") {
