END
PROGRAM init_sel
BEGIN
  call program ng_show
  if sel.ck_sel {
    call script sel_on
  }
  if !sel.ck_sel {
    call script sel_off
  }
END

// the bootstrap options, live only with vce(bootstrap) and the estimation
PROGRAM vce_state
BEGIN
  if main.cb_vce.iseq("bootstrap") & !has_diag {
    call main.tx_reps.enable
    call main.sp_reps.enable
    call main.tx_seed.enable
    call main.ed_seed.enable
    call main.ck_bsvy.enable
  }
  if !main.cb_vce.iseq("bootstrap") | has_diag {
    call main.tx_reps.disable
    call main.sp_reps.disable
    call main.tx_seed.disable
    call main.ed_seed.disable
    call main.ck_bsvy.disable
  }
END

LIST actlist
BEGIN
1 - Estimation
2 - Diagnostic
END

LIST actvals
BEGIN
est
diag
END

// one entry per combobox item, in order
LIST action_change
BEGIN
        script mode_est
        script mode_diag
END

LIST elaslist
BEGIN
	default (households, individuals with a size)
	households
	individuals
	market
END

LIST elasvals
BEGIN
	default
	households
	individuals
	market
END

LIST vcelist
BEGIN
	robust
	survey design (svyset)
	conventional
	bootstrap
END

LIST vcevals
BEGIN
	robust
	svy
	conventional
	bootstrap
END

// -easidiag- uses none of the reporting or variance controls.  Leaving them
// live under the diagnostic would let the user fill boxes that are then
// dropped without a word, which is the silent failure this module avoids
// everywhere else, so they are greyed out instead.
SCRIPT mode_est
BEGIN
        has_diag.setfalse
        program set_action_mode
END

SCRIPT mode_diag
BEGIN
        has_diag.settrue
        program set_action_mode
END

PROGRAM set_action_mode
BEGIN
        if has_diag {
                call main.tx_vce.disable
                call main.cb_vce.disable
                call resop.sp_dec.disable
                call resop.sp_txt.disable
                call resop.ck_dregres.disable
                call resop.ck_dislas.disable
                call resop.ck_comp.disable
                call resop.ck_demoel.disable
                call resop.ck_checks.disable
                call resop.ck_noese.disable
                call resop.ck_stars.disable
                call resop.tx_save.disable
                call resop.fi_save.disable
                call resop.ck_notab.disable
                call resop.ck_compat.disable
        }
        if !has_diag {
                call main.tx_vce.enable
                call main.cb_vce.enable
                call resop.sp_dec.enable
                call resop.sp_txt.enable
                call resop.ck_dregres.enable
                call resop.ck_dislas.enable
                call resop.ck_comp.enable
                call resop.ck_demoel.enable
                call resop.ck_checks.enable
                call resop.ck_noese.enable
                call resop.ck_stars.enable
                call resop.tx_save.enable
                call resop.fi_save.enable
                call resop.ck_notab.enable
                call resop.ck_compat.enable
        }
        call program vce_state
END

SCRIPT PREINIT
BEGIN
create BOOLEAN has_ini
create BOOLEAN has_diag                         
END





SCRIPT POSTINIT
BEGIN
  program init_sel
  program vce_state
END

HELP hlp1,   view("help easi")
RESET res1
OK      ok1,      label("OK")
CANCEL can1, label("Cancel")
SUBMIT sub1, label("Submit")
COPY  copy1,

PROGRAM command
BEGIN
        if has_diag {
                put "easidiag "
        }
        if !has_diag {
                put "easi "
        }
        require  main.name_items
        varlist [main.name_items]
      

        beginoptions  
        put " "
        optionarg main.name_prices
		optionarg main.name_snames
		optionarg main.vn_hhexp
		
        optionarg main.vl_inddemo
		optionarg sel.vl_pimp
	if sel.ck_sel {
		put " selection"
		if sel.ed_selg {
			put " selgoods(" sel.ed_selg ")"
		}
		if sel.vl_v1 {
			require sel.ed_g1
		}
		if sel.ed_g1 {
			require sel.vl_v1
		}
		if sel.vl_v2 {
			require sel.ed_g2
		}
		if sel.ed_g2 {
			require sel.vl_v2
		}
		if sel.vl_v3 {
			require sel.ed_g3
		}
		if sel.ed_g3 {
			require sel.vl_v3
		}
		if sel.vl_v4 {
			require sel.ed_g4
		}
		if sel.ed_g4 {
			require sel.vl_v4
		}
		if sel.vl_v5 {
			require sel.ed_g5
		}
		if sel.ed_g5 {
			require sel.vl_v5
		}
		if sel.vl_v6 {
			require sel.ed_g6
		}
		if sel.ed_g6 {
			require sel.vl_v6
		}
		if sel.vl_v7 {
			require sel.ed_g7
		}
		if sel.ed_g7 {
			require sel.vl_v7
		}
		if sel.vl_v8 {
			require sel.ed_g8
		}
		if sel.ed_g8 {
			require sel.vl_v8
		}
		if sel.vl_v9 {
			require sel.ed_g9
		}
		if sel.ed_g9 {
			require sel.vl_v9
		}
		if sel.vl_v10 {
			require sel.ed_g10
		}
		if sel.ed_g10 {
			require sel.vl_v10
		}
		if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 | sel.ed_g7 | sel.ed_g8 | sel.ed_g9 | sel.ed_g10 {
			put " selvars("
			put sel.vl_all
			if sel.ed_g1 {
				if sel.vl_all {
					put "; "
				}
				put sel.ed_g1 ": " sel.vl_v1
			}
			if sel.ed_g2 {
				if sel.vl_all | sel.ed_g1 {
					put "; "
				}
				put sel.ed_g2 ": " sel.vl_v2
			}
			if sel.ed_g3 {
				if sel.vl_all | sel.ed_g1 | sel.ed_g2 {
					put "; "
				}
				put sel.ed_g3 ": " sel.vl_v3
			}
			if sel.ed_g4 {
				if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 {
					put "; "
				}
				put sel.ed_g4 ": " sel.vl_v4
			}
			if sel.ed_g5 {
				if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 {
					put "; "
				}
				put sel.ed_g5 ": " sel.vl_v5
			}
			if sel.ed_g6 {
				if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 {
					put "; "
				}
				put sel.ed_g6 ": " sel.vl_v6
			}
			if sel.ed_g7 {
				if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 {
					put "; "
				}
				put sel.ed_g7 ": " sel.vl_v7
			}
			if sel.ed_g8 {
				if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 | sel.ed_g7 {
					put "; "
				}
				put sel.ed_g8 ": " sel.vl_v8
			}
			if sel.ed_g9 {
				if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 | sel.ed_g7 | sel.ed_g8 {
					put "; "
				}
				put sel.ed_g9 ": " sel.vl_v9
			}
			if sel.ed_g10 {
				if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 | sel.ed_g7 | sel.ed_g8 | sel.ed_g9 {
					put "; "
				}
				put sel.ed_g10 ": " sel.vl_v10
			}
			put ")"
		}
	}
		
	if !has_diag {
                        if !resop.sp_dec.isdefault() {
                        optionarg resop.sp_dec
                        }
						
                optionarg resop.ck_dregres 
				optionarg resop.ck_dislas
                option resop.ck_stars
                if resop.fi_save {
                        optionarg /quoted resop.fi_save
                }
                option resop.ck_notab
                option resop.ck_compat
		if resop.ck_comp {
			put " compensated"
		}
		if resop.ck_demoel {
			put " demoelast"
		}
		if resop.ck_checks {
			put " checks"
		}
		if resop.ck_noese {
			put " noelastse"
		}
	}
				
				optionarg main.sp_pow
				optionarg main.ck_inpy
				optionarg main.ck_inpz
				optionarg main.ck_inzy
		if !has_diag {
			if main.cb_vce.iseq("svy") | main.cb_vce.iseq("conventional") {
				optionarg main.cb_vce
			}
			if main.cb_vce.iseq("bootstrap") {
				put " vce(bootstrap, reps(" main.sp_reps ")"
				if main.ed_seed {
					put " seed(" main.ed_seed ")"
				}
				if main.ck_bsvy {
					put " svy"
				}
				put ")"
			}
		}
		if !main.cb_elas.isdefault() {
			optionarg main.cb_elas
		}
		optionarg main.vn_hhs

                                       
        endoptions
        
        
        
END
